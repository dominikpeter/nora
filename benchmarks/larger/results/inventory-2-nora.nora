%%rust
#[derive(Debug, PartialEq, Eq)]
pub struct Stock {
    pub sku: String,
    pub quantity: i64,
    pub unit_cents: i64,
}

pub fn nora_parse(input: &str) -> Result<Vec<Stock>, String> {
    let mut items = std::collections::BTreeMap::<String, Stock>::new();

    for (index, line) in input.lines().enumerate() {
        let number = index + 1;
        let line = line.trim();
        if line.is_empty() || line.starts_with('#') {
            continue;
        }

        let fields: Vec<&str> = line.split(',').map(str::trim).collect();
        if fields.len() != 3 {
            return Err(format!("line {}: fields", number));
        }

        let sku = fields[0];
        if sku.is_empty()
            || !sku.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
        {
            return Err(format!("line {}: sku", number));
        }

        let quantity = fields[1]
            .parse::<i64>()
            .ok()
            .filter(|&value| value >= 0)
            .ok_or_else(|| format!("line {}: quantity", number))?;

        let unit_cents = fields[2]
            .parse::<i64>()
            .ok()
            .filter(|&value| value >= 0)
            .ok_or_else(|| format!("line {}: price", number))?;

        if let Some(stock) = items.get_mut(sku) {
            if stock.unit_cents != unit_cents {
                return Err(format!("line {}: price conflict", number));
            }
            stock.quantity = stock
                .quantity
                .checked_add(quantity)
                .ok_or_else(|| format!("line {}: quantity overflow", number))?;
        } else {
            items.insert(
                sku.to_owned(),
                Stock {
                    sku: sku.to_owned(),
                    quantity,
                    unit_cents,
                },
            );
        }
    }

    Ok(items.into_values().collect())
}

pub fn nora_report(items: &[Stock], threshold: i64) -> String {
    let mut sorted: Vec<&Stock> = items.iter().collect();
    sorted.sort_unstable_by(|a, b| a.sku.cmp(&b.sku));

    let mut rows = Vec::with_capacity(items.len() + 1);
    let mut total = 0i64;

    for stock in sorted {
        let value = stock.quantity * stock.unit_cents;
        total += value;
        let state = if stock.quantity < threshold { "low" } else { "ok" };
        rows.push(format!(
            "{}:{}:{}:{}",
            stock.sku, stock.quantity, value, state
        ));
    }

    rows.push(format!("total={}", total));
    rows.join("\n")
}