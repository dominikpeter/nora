fn nora_offset(x: i64, delta: i64) -> i64 {
    x + delta
}

fn nora_total(q: i64, price: i64, discount: i64) -> i64 {
    q * price - discount
}

fn nora_label(a: i64, b: i64) -> String {
    (a + b).to_string()
}

fn nora_identity(x: String) -> String {
    x
}

fn nora_bucket(x: i64, width: i64) -> i64 {
    (x + 3) / width
}